{
  // Cloudflare Workers + statické soubory (nástupce Cloudflare Pages).
  // Nasazení: npm run deploy  (= npx wrangler deploy)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "letonicespolecne",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // skript běží jen kvůli přesměrování www -> holá doména
    "run_worker_first": true
  },
  "observability": { "enabled": false },
  "routes": [
    { "pattern": "letonicespolecne.cz", "custom_domain": true },
    { "pattern": "www.letonicespolecne.cz", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": false
}
